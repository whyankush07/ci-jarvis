# Example environment variables for Jarvis
# Copy to .env and fill in real secrets before running locally or in Docker.

# Server
PORT=8080

# Postgres (for local docker-compose use the service name 'postgres')
DATABASE_URL=postgres://devagent:devagent@postgres:5432/devagent?sslmode=disable

# Redis (for local docker-compose use the service name 'redis')
REDIS_URL=redis://localhost:6379

# Qdrant (vector DB)
QDRANT_URL=http://qdrant:6333

# LLM / API keys
OPENAI_KEY=
GEMINI_API_KEY=

# Webhook secret used to validate GitHub webhook signatures
GITHUB_WEBHOOK_SECRET=change_me
